---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import LangToggle from "@/components/LangToggle";
import ReportForm from "@/components/ReportForm";
import Footer from "@/components/Footer.astro";
import { getTranslation } from "@/lib/i18n";
import { getReportStrings } from "@/lib/i18n/report";
import { getConvertHubCopy } from "@/lib/seo/version-pages-i18n";

const lang = "ja";
const t = getTranslation(lang);
const s = getReportStrings(lang);
const hubCopy = getConvertHubCopy(lang);
---

<Layout
	title={`${s.pageTitle} - PackBridge`}
	description={s.pageDescription}
	keywords={t.keywords}
	lang={lang}
	breadcrumbs={[{ name: s.pageTitle, path: "/report" }]}
>
	<div class="top-controls">
		<LangToggle client:load />
		<ThemeToggle client:load />
	</div>

	<main class="container">
		<nav class="breadcrumb-nav animate-fade-up" aria-label="Breadcrumb">
			<a href="/" data-astro-prefetch="tap">{hubCopy.breadcrumbHome}</a>
			<span class="sep">/</span>
			<span aria-current="page">{s.pageTitle}</span>
		</nav>

		<header class="animate-fade-up stagger-1">
			<div class="brand-name">{t.heading}</div>
			<h1>{s.pageTitle}</h1>
			<p class="description">{s.pageDescription}</p>
		</header>

		<div class="animate-fade-up stagger-2">
			<ReportForm client:load lang="ja" backToHome={t.backToHome} />
		</div>

		<div class="animate-fade-up stagger-4">
			<Footer t={t} lang="ja" />
		</div>
	</main>
</Layout>
