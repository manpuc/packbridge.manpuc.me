---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import LangToggle from "@/components/LangToggle";
import Footer from "@/components/Footer.astro";
import { getTranslation } from "@/lib/i18n";
import { getConvertHubCopy } from "@/lib/seo/version-pages-i18n";

const lang = "ja";
const t = getTranslation(lang);
const hubCopy = getConvertHubCopy(lang);
---

<Layout
	title={`${t.terms} - PackBridge`}
	description={t.description}
	keywords={t.keywords}
	lang={lang}
	breadcrumbs={[{ name: t.terms, path: "/terms" }]}
>
	<div class="top-controls">
		<LangToggle client:load />
		<ThemeToggle client:load />
	</div>

	<main class="container">
		<nav class="breadcrumb-nav animate-fade-up" aria-label="Breadcrumb">
			<a href="/" data-astro-prefetch="tap">{hubCopy.breadcrumbHome}</a>
			<span class="sep">/</span>
			<span aria-current="page">{t.terms}</span>
		</nav>

		<header class="animate-fade-up stagger-1">
			<div class="brand-name">{t.heading}</div>
			<h1>{t.terms}</h1>
			<p class="description">最終更新: {t.termsLastUpdated}</p>
		</header>

		<div class="terms-grid animate-fade-up stagger-2">
			{
				t.termsSections.map((item, idx) => (
					<>
						{idx > 0 && <div class="flat-divider" role="separator" />}
						<section class="terms-section">
							<h2>{item.title}</h2>
							<p>{item.content}</p>
						</section>
					</>
				))
			}
		</div>

		<div class="terms-footer animate-fade-up stagger-3">
			<p class="os-text">
				{t.openSourceText}
			</p>
			<div class="footer-buttons">
				<a
					href="https://github.com/manpuc/packbridge.manpuc.me"
					target="_blank"
					rel="noopener noreferrer"
					class="footer-link source-link"
				>
					{t.viewSourceCode}
				</a>
				<a href="/" class="footer-link" data-astro-prefetch="tap">
					{t.backToHome}
				</a>
			</div>
		</div>

		<div class="animate-fade-up stagger-4">
			<Footer t={t} lang={lang} />
		</div>
	</main>
</Layout>

<style>
	.terms-grid {
		display: flex;
		flex-direction: column;
		gap: 22px;
		padding: 4px 14px;
	}

	.flat-divider {
		height: 1px;
		background: var(--color-border);
		width: 100%;
		opacity: 0.8;
	}

	.terms-section {
		display: flex;
		flex-direction: column;
		gap: 8px;
		background: transparent;
		border: none;
		box-shadow: none;
		padding: 0;
	}

	.terms-section h2 {
		font-size: 13px;
		font-weight: 700;
		color: var(--color-text);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		opacity: 0.7;
		margin: 0;
	}

	.terms-section p {
		font-size: 13.5px;
		line-height: 1.65;
		font-weight: 500;
		color: var(--color-text-muted);
		white-space: pre-wrap;
		margin: 0;
	}

	.terms-footer {
		margin-top: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 28px 14px 0;
		border-top: 1px solid var(--color-border);
	}

	.os-text {
		font-size: 13px;
		color: var(--color-text-muted);
		text-align: center;
	}

	.footer-buttons {
		display: flex;
		flex-direction: row;
		justify-content: center;
		gap: 24px;
		flex-wrap: wrap;
	}

	.footer-buttons .footer-link {
		font-weight: 600;
		color: var(--color-text);
	}
</style>
