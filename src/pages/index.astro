---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import LangToggle from "@/components/LangToggle";
import Converter from "@/components/Converter";
import IntroAccordion from "@/components/IntroAccordion";
import Footer from "@/components/Footer.astro";
import { getTranslation } from "@/lib/i18n";

const lang = "ja";
const t = getTranslation(lang);
---

<Layout
	title={t.title}
	description={t.metaDescription}
	keywords={t.keywords}
	lang="ja"
>
	<div class="top-controls">
		<LangToggle client:load />
		<ThemeToggle client:load />
	</div>

	<main class="container">
		<header class="animate-fade-up stagger-1">
			<div class="brand-name">{t.heading}</div>
			<h1>{t.h1Title}</h1>
			<p class="description">{t.description}</p>
		</header>

		<div class="animate-fade-up stagger-2">
			<Converter client:load t={t} lang={lang} />
		</div>

				<div class="animate-fade-up stagger-3">
			<IntroAccordion client:load t={t} />
		</div>

		<div class="animate-fade-up stagger-4">
			<Footer t={t} lang={lang} />
		</div>
	</main>
</Layout>


