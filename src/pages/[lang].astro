---
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import LangToggle from "@/components/LangToggle";
import Converter from "@/components/Converter";
import IntroAccordion from "@/components/IntroAccordion";
import PopularConversions from "@/components/seo/PopularConversions.astro";
import Footer from "@/components/Footer.astro";
import { getTranslation, SUPPORTED_LANGUAGES, type Language } from "@/lib/i18n";

export function getStaticPaths() {
	return SUPPORTED_LANGUAGES.filter((lang) => lang !== "ja").map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as Language;
const t = getTranslation(lang);
---

<Layout
	title={t.title}
	description={t.metaDescription}
	keywords={t.keywords}
	lang={lang}
>
	<div class="top-controls">
		<LangToggle client:load />
		<ThemeToggle client:load />
	</div>

	<main class="container">
		<header>
			<div class="brand-name">{t.heading}</div>
			<h1>{t.h1Title}</h1>
			<p class="description">{t.description}</p>
		</header>

		<Converter client:load t={t} lang={lang} />

		<IntroAccordion client:load t={t} />

		<PopularConversions lang={lang} />

		<Footer t={t} lang={lang} />
	</main>
</Layout>
