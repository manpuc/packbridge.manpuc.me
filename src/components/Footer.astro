---
import type { Translation, Language } from "@/lib/i18n";
import { getReportStrings, reportHref, APP_VERSION } from "@/lib/i18n/report";

interface Props {
	t: Translation;
	lang?: string;
}

const { t, lang = "ja" } = Astro.props;
const termsHref = `/${lang}/terms`;
const rs = getReportStrings(lang as Language);
---

<footer>
	<div class="footer-main">
		<div class="footer-credit">
			{t.footer}
		</div>

		<div class="footer-links">
			<a href={termsHref} class="footer-link" data-astro-prefetch="tap">{t.terms}</a>
			<a
				href={reportHref(lang)}
				class="footer-link"
				data-astro-prefetch="tap"
				data-umami-event="report_click"
				data-umami-event-source="footer"
			>{rs.link}</a>
		</div>
	</div>

	<div class="footer-bottom">
		<a
			href="https://www.manpuc.me"
			target="_blank"
			rel="noopener noreferrer"
			class="footer-info"
		>
			<img
				src="https://www.manpuc.me/favicon.svg"
				alt="manpuc official developer logo"
				class="footer-logo"
				width="24"
				height="24"
				loading="lazy"
			/>
			<span class="developed-by">Developed by manpuc</span>
		</a>
		<span class="app-version">v{APP_VERSION}</span>
	</div>
</footer>

<style>
	.footer-main {
		text-align: center;
	}
	.footer-credit {
		text-align: center;
		line-height: 1.5;
	}
	.footer-bottom {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 6px;
		width: 100%;
	}
	.app-version {
		font-size: 12px;
		color: var(--color-text-muted);
		font-feature-settings: "tnum";
		letter-spacing: 0.02em;
	}
	@media (pointer: coarse) {
		.footer-info {
			min-height: 44px;
		}
	}
</style>
